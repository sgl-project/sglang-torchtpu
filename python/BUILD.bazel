        "@sglang_pypi//tokenizers",
        "@sglang_pypi//torch",
        "@sglang_pypi//torchvision",
        "@sglang_pypi//tqdm",
        "@sglang_pypi//transformers",
        "@sglang_pypi//triton",
        "@sglang_pypi//typing_extensions",
        "@sglang_pypi//urllib3",
        "@sglang_pypi//uvicorn",
        "@sglang_pypi//uvloop",
        "@sglang_pypi//xgrammar",
        "@sglang_pypi//xxhash",
        "@torch_tpu//shims/jax:pallas",
        "@torch_tpu//torch_tpu",
        # Pure-Python pallas package (torch_tpu._internal.pallas: __init__.py +
        # pallas.py, which defines jax_op). The //torch_tpu aggregator only
        # re-exports torch.tpu/xla modules and the pywrap only bundles the C++
        # extensions, so without this dep the pallas __init__/pallas.py never
        # reach runfiles and `from torch_tpu._internal.pallas import jax_op`
        # fails with "cannot import name 'jax_op' ... (unknown location)".
        "@torch_tpu//torch_tpu/_internal/pallas",
    ],
)
