# The benchmark cells import this sibling module by its top-level name.
py_library(
    name = "bench_matrix_base",
    srcs = ["bench_matrix_base.py"],
    imports = ["."],
    deps = ["//python:sglang"],
)

# These single-host benchmarks exercise an already-running server at BASE_URL.
# Enable their live-server gate explicitly so a Bazel invocation does not skip.
# The spec_kvoff cells require a server with raiden support.

sglang_tpu_e2e_test(
    name = "test_tpu_bench_qwen3_coder_480b_1host_pc_8k1k",
    srcs = ["test_tpu_bench_qwen3_coder_480b_1host_pc_8k1k.py"],
    data = ["//benchmark/tpu:runtime"],
    env = {"SGLANG_TPU_USE_LIVE_SERVER": "1"},
    main = "test_tpu_bench_qwen3_coder_480b_1host_pc_8k1k.py",
    tags = [
        "requires-live-server",
        "requires-tpu-v7x",
    ],
    deps = [
        ":bench_matrix_base",
        "//python:sglang",
        "@torch_tpu//torch_tpu/csrc/common:pywrap_torch_tpu",
    ],
)

