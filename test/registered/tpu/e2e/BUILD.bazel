    name = "test_tpu_qwen3_coder_30b_singlehost_lm_eval",
    srcs = ["test_tpu_qwen3_coder_30b_singlehost_lm_eval.py"],
    data = [
        "//benchmark/tpu:runtime",
        "//test/lm_eval_configs:Qwen3-Coder-30B-A3B-Instruct-FP8-TPU.yaml",
    ],
    main = "test_tpu_qwen3_coder_30b_singlehost_lm_eval.py",
    tags = [
        "requires-tpu-v7x",
    ],
    deps = [
        "//python:tpu_launcher_test_support",
        "@torch_tpu//torch_tpu/csrc/common:pywrap_torch_tpu",
    ],
)

